---
/**
 * Film dust over the black (after reference/web.jpg.jpeg): specks, denser in the top-left
 * corner, and a few fine scratches. Generated at build time from a seed, so it never changes
 * between visits. Fills its positioned parent; viewBox 1600×900, anchored top-left.
 */
interface Props {
  /** Different seeds give different (but stable) dust. */
  seed?: number;
}

const { seed = 7 } = Astro.props;

const rand = (() => {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
})();
const r1 = (n: number) => +n.toFixed(1);
const specks = Array.from({ length: 280 }, () => {
  const cluster = rand() < 0.35;
  return {
    x: r1(cluster ? rand() ** 1.6 * 280 : rand() * 1600),
    y: r1(cluster ? rand() ** 1.3 * 560 : rand() * 900),
    r: r1(0.35 + rand() ** 3 * 1.4),
    o: +(0.15 + rand() * 0.55).toFixed(2),
  };
});
const scratches = Array.from({ length: 14 }, () => {
  const x = rand() * 1600;
  const y = rand() * 900;
  const len = 6 + rand() ** 2 * 50;
  const angle = rand() * Math.PI;
  const bend = (rand() - 0.5) * len * 0.3;
  const x2 = x + Math.cos(angle) * len;
  const y2 = y + Math.sin(angle) * len;
  return {
    d: `M${r1(x)} ${r1(y)} Q${r1((x + x2) / 2 + bend)} ${r1((y + y2) / 2 - bend)} ${r1(x2)} ${r1(y2)}`,
    o: +(0.15 + rand() * 0.35).toFixed(2),
    w: r1(0.4 + rand() * 0.5),
  };
});
---

<svg class="dust" viewBox="0 0 1600 900" preserveAspectRatio="xMinYMin slice" aria-hidden="true" focusable="false">
  {specks.map((d) => <circle cx={d.x} cy={d.y} r={d.r} opacity={d.o} />)}
  {scratches.map((d) => <path d={d.d} opacity={d.o} stroke-width={d.w} />)}
</svg>

<style>
  .dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #fff;
    stroke: #fff;
    opacity: 0.55;
    pointer-events: none;
  }

  .dust path {
    fill: none;
  }
</style>
