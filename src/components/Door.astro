---
/**
 * One bay of the Branding hall (after reference/Four White Doors in the Endless Hall.png): a light
 * set flat into the ceiling, shining down on the wall and a white double door that links to the
 * brand's page; the light it throws on the rough ceiling, the wall and the glossy floor. The door is built for material depth, after the reference: a stepped
 * architrave standing proud of the wall, tall raised panels with fine lit and shaded mouldings,
 * steel bar pulls on posts, hinges, light falling off from the top, and leaves with real
 * thickness. Hovering or focusing the door swings the leaves open into the room behind, where the
 * brand sits in its own coloured light; the light spills onto the glossy floor, which reflects the
 * door and the ceiling light; the rough rock ceiling catches the light around each fixture (in the
 * brand's colour when its door is open). The hall page sets
 * the sizes and the camera (--door-w, --door-h, --horizon, --wall-h, --eye, --lens, --dx), lays the
 * rough floor and rock ceiling textures over everything and handles walking through (`.is-open`
 * while entering, `.is-centered` on narrow screens).
 */
import BrandMark from './BrandMark.astro';
import type { Brand } from '../data/brands';

interface Props {
  brand: Brand;
  index: number;
}

const { brand, index } = Astro.props;
---

<li class="bay" style={`--i: ${index}; --brand: ${brand.color}`}>
  <span class="bay__ceiling" aria-hidden="true">
    <span class="bay__glow"></span>
    <span class="bay__fixture"></span>
  </span>
  <span class="bay__cone" aria-hidden="true"></span>
  <span class="bay__pool" aria-hidden="true"></span>
  <span class="bay__streak" aria-hidden="true"></span>
  <span class="bay__glint" aria-hidden="true"></span>
  <a class="door" href={`/branding/${brand.slug}`} data-door>
    {
      [false, true].map((mirror) => (
        <span class={mirror ? 'door__mirror' : 'door__body'} aria-hidden={mirror ? 'true' : undefined}>
          <span class="door__frame">
            <span class="door__opening">
              <span class="door__inside" aria-hidden="true">
                <span class="door__mark">
                  <BrandMark shape={brand.mark} />
                </span>
                <span class="door__brand">{brand.name}</span>
              </span>
              {['left', 'right'].map((side) => (
                <span class={`door__leaf door__leaf--${side}`}>
                  <span class="door__panel door__panel--top" />
                  <span class="door__panel door__panel--bottom" />
                  <span class="door__hinge door__hinge--top" />
                  <span class="door__hinge door__hinge--bottom" />
                  <span class="door__handle" />
                  <span class="door__sheen" />
                  <span class="door__edge" />
                </span>
              ))}
            </span>
          </span>
        </span>
      ))
    }
    <span class="door__spill" aria-hidden="true"></span>
    <span class="sr-only">{brand.name}</span>
  </a>
</li>

<style>
  /* Each bay is a little 3D scene that shares the hall's eye point: the same perspective as the
     hall's floor and ceiling, with the vanishing point at the middle of the hall (--dx is how far
     this bay's centre is from it). */
  .bay {
    position: relative;
    perspective: var(--lens);
    perspective-origin: calc(50% - var(--dx, 0px)) var(--eye);
  }

  /* ── The light, set flat into the ceiling and facing down ──
     A patch of ceiling, hinged at the top of the wall and turned flat towards the viewer, so the
     fixture on it is seen from below at an angle (a thin, slightly slanted panel), and the light it
     throws on the ceiling around it opens into a fan. */
  .bay__ceiling {
    position: absolute;
    top: calc(var(--horizon) - var(--wall-h) - var(--door-w) * 4);
    left: 50%;
    width: calc(var(--door-w) * 5);
    height: calc(var(--door-w) * 4);
    translate: -50% 0;
    transform-origin: 50% 100%;
    transform: rotateX(-90deg);
    pointer-events: none;
  }

  .bay__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 16% 60% at 50% 100%,
      rgb(255 255 255 / 0.22),
      rgb(255 255 255 / 0.08) 40%,
      rgb(255 255 255 / 0.018) 72%,
      transparent
    );
  }

  /* When the door opens, its light reaches the ceiling: the fan takes on the brand's colour. */
  .bay__glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 19% 62% at 50% 100%,
      color-mix(in srgb, var(--brand) 40%, transparent),
      color-mix(in srgb, var(--brand) 14%, transparent) 45%,
      transparent 78%
    );
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .bay__fixture {
    position: absolute;
    bottom: calc(var(--door-w) * 0.04);
    left: 50%;
    width: calc(var(--door-w) * 0.37);
    height: calc(var(--door-w) * 0.12);
    translate: -50% 0;
    border-radius: 1px;
    background: #fff;
    box-shadow:
      0 0 calc(var(--door-w) * 0.015) 1px #fff,
      0 0 calc(var(--door-w) * 0.06) rgb(255 255 255 / 0.55);
  }

  /* The wall below the light: brightest just under it, washing down to the top of the door. */
  .bay__cone {
    position: absolute;
    top: calc(var(--horizon) - var(--wall-h));
    left: 50%;
    width: calc(var(--door-w) * 2.1);
    height: var(--wall-h);
    translate: -50% 0;
    background:
      radial-gradient(ellipse 18% 9% at 50% 0%, rgb(255 255 255 / 0.22), transparent),
      radial-gradient(
        ellipse 38% 72% at 50% 0%,
        rgb(255 255 255 / 0.15),
        rgb(255 255 255 / 0.06) 38%,
        rgb(255 255 255 / 0.018) 70%,
        transparent
      );
    pointer-events: none;
  }

  /* Rough wall texture, faded out with the light so it only shows where the wall is lit. */
  .bay__cone::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    background-size: 90px 90px;
    opacity: 0.16;
    -webkit-mask-image: radial-gradient(ellipse 38% 72% at 50% 0%, #000, rgb(0 0 0 / 0.35) 40%, transparent 75%);
    mask-image: radial-gradient(ellipse 38% 72% at 50% 0%, #000, rgb(0 0 0 / 0.35) 40%, transparent 75%);
  }

  /* ── The glossy floor: a pool of light in front of the door, the door's reflection smeared into
     a long streak (brightest down the middle), and the ceiling light reflected where a mirror
     puts it (as far below the floor line as the light is above it). The hall's rough floor
     texture, laid over these, breaks them up. ── */

  .bay__pool,
  .bay__streak,
  .bay__glint {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    pointer-events: none;
  }

  .bay__pool {
    top: var(--horizon);
    width: calc(var(--door-w) * 3.4);
    height: calc(var(--door-h) * 1.9);
    background: radial-gradient(
      ellipse 45% 70% at 50% 0%,
      rgb(255 255 255 / 0.1),
      rgb(255 255 255 / 0.045) 35%,
      rgb(255 255 255 / 0.025) 70%,
      transparent
    );
  }

  .bay__streak {
    top: var(--horizon);
    width: calc(var(--door-w) * 0.95);
    height: calc(var(--door-h) * 1.75);
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.32),
      rgb(255 255 255 / 0.42) 40%,
      rgb(255 255 255 / 0.42) 62%,
      rgb(255 255 255 / 0.3) 80%,
      rgb(255 255 255 / 0.15) 93%,
      transparent
    );
    -webkit-mask-image: linear-gradient(90deg, transparent, rgb(0 0 0 / 0.6) 18%, #000 38%, #000 62%, rgb(0 0 0 / 0.6) 82%, transparent);
    mask-image: linear-gradient(90deg, transparent, rgb(0 0 0 / 0.6) 18%, #000 38%, #000 62%, rgb(0 0 0 / 0.6) 82%, transparent);
    filter: blur(calc(var(--door-w) * 0.035));
  }

  /* Stretched into a tall streak, as lights are on a glossy floor. */
  .bay__glint {
    top: calc(var(--horizon) + var(--wall-h) - var(--door-h) * 1);
    width: calc(var(--door-w) * 0.6);
    height: calc(var(--door-h) * 1.55);
    background: radial-gradient(
      ellipse 50% 50%,
      rgb(255 255 255 / 0.7),
      rgb(255 255 255 / 0.3) 35%,
      rgb(255 255 255 / 0.08) 60%,
      transparent 75%
    );
    filter: blur(calc(var(--door-w) * 0.02));
  }

  /* ── The door ── */

  .door {
    position: absolute;
    top: calc(var(--horizon) - var(--door-h));
    left: 50%;
    width: var(--door-w);
    height: var(--door-h);
    translate: -50% 0;
    color: var(--color-fg);
    text-decoration: none;
  }

  .door__body {
    position: absolute;
    inset: 0;
  }

  /* Architrave: painted moulding standing proud of the wall, lit from the light above (bright at
     the top, falling off down the sides), casting a soft shadow on the wall. */
  .door__frame {
    position: absolute;
    inset: 0;
    padding: calc(var(--door-w) * 0.085) calc(var(--door-w) * 0.085) 0;
    background:
      radial-gradient(ellipse 80% 45% at 50% 0%, rgb(255 255 255 / 0.6), transparent 75%),
      linear-gradient(to bottom, #f4f4f4, #dedede 45%, #c6c6c6);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.65),
      0 calc(var(--door-w) * 0.02) calc(var(--door-w) * 0.07) rgb(0 0 0 / 0.7),
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 1px 0 0 rgb(255 255 255 / 0.5),
      inset -1px 0 0 rgb(0 0 0 / 0.15);
    transition: box-shadow 800ms var(--ease-out);
  }

  /* The architrave's stepped profile: a fine shadow line and a lit line, part-way across. */
  .door__frame::before {
    content: '';
    position: absolute;
    inset: calc(var(--door-w) * 0.036) calc(var(--door-w) * 0.036) 0;
    border: 1px solid rgb(0 0 0 / 0.16);
    border-bottom: 0;
    box-shadow:
      inset 1px 1px 0 rgb(255 255 255 / 0.85),
      -1px -1px 0 rgb(255 255 255 / 0.45);
    pointer-events: none;
  }

  /* The opening; the leaves swing inside it, in perspective. */
  .door__opening {
    position: relative;
    display: block;
    height: 100%;
    background: #030303;
    perspective: calc(var(--door-w) * 3);
  }

  /* Stop bead round the top and sides of the opening (none across the floor). */
  .door__opening::before {
    content: '';
    position: absolute;
    inset: calc(var(--door-w) * -0.009 - 1px) calc(var(--door-w) * -0.009 - 1px) 0;
    border: calc(var(--door-w) * 0.009) solid #d4d4d4;
    border-bottom: 0;
    box-shadow:
      0 -1px 0 rgb(0 0 0 / 0.3),
      inset 0 1px 0 rgb(255 255 255 / 0.6);
  }

  /* The room behind the door: the brand in its own light. Dim until the door opens. */
  .door__inside {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(var(--door-w) * 0.06);
    overflow: hidden;
    color: #fff;
    background: radial-gradient(
      ellipse 80% 70% at 50% 45%,
      var(--brand),
      color-mix(in oklab, var(--brand) 45%, #000) 55%,
      color-mix(in oklab, var(--brand) 12%, #000)
    );
    filter: brightness(0.25);
    transition: filter 900ms var(--ease-out);
  }

  .door__mark {
    display: block;
    width: 40%;
    filter: drop-shadow(0 0 calc(var(--door-w) * 0.04) rgb(255 255 255 / 0.7));
    transition: opacity 500ms var(--ease-out);
  }

  .door__mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .door__brand {
    padding-left: 0.3em; /* balances the trailing letter-spacing */
    font-size: calc(var(--door-w) * 0.06);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 500ms var(--ease-out);
  }

  /* Leaves: painted, lit from above (a hotspot at the top, greyer towards the floor), in the shadow
     of the head casing and of the side casing at the hinge; they meet at a fine dark gap. They have
     real thickness (.door__edge) that shows as they swing open. */
  .door__leaf {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background:
      radial-gradient(ellipse 140% 55% at 50% 0%, rgb(255 255 255 / 0.65), transparent 72%),
      linear-gradient(to bottom, #f3f3f3, #e4e4e4 45%, #cfcfcf);
    transform-style: preserve-3d;
    transition: transform 800ms var(--ease-in-out);
  }

  .door__leaf--left {
    left: 0;
    transform-origin: left center;
    box-shadow:
      inset 0 calc(var(--door-w) * 0.035) calc(var(--door-w) * 0.04) calc(var(--door-w) * -0.025) rgb(0 0 0 / 0.3),
      inset calc(var(--door-w) * 0.025) 0 calc(var(--door-w) * 0.035) calc(var(--door-w) * -0.02) rgb(0 0 0 / 0.16),
      inset -1px 0 0 rgb(0 0 0 / 0.55),
      inset -2px 0 0 rgb(255 255 255 / 0.45);
  }

  .door__leaf--right {
    right: 0;
    transform-origin: right center;
    box-shadow:
      inset 0 calc(var(--door-w) * 0.035) calc(var(--door-w) * 0.04) calc(var(--door-w) * -0.025) rgb(0 0 0 / 0.3),
      inset calc(var(--door-w) * -0.025) 0 calc(var(--door-w) * 0.035) calc(var(--door-w) * -0.02) rgb(0 0 0 / 0.16),
      inset 1px 0 0 rgb(255 255 255 / 0.85);
  }

  /* Faint paint texture. */
  .door__leaf::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    background-size: 120px 120px;
    opacity: 0.06;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Raised and fielded panels (proportions from the reference): a fine moulding round each, lit on
     top and in shade below, with a soft shadow under it; the field inside is flat. */
  .door__panel {
    position: absolute;
    left: 16%;
    right: 16%;
    border: calc(var(--door-w) * 0.009) solid;
    border-color: #fff #d2d2d2 #b0b0b0 #e8e8e8;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.25), rgb(0 0 0 / 0.03));
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.16),
      0 1px 0 1px rgb(255 255 255 / 0.5),
      0 calc(var(--door-w) * 0.008) calc(var(--door-w) * 0.014) rgb(0 0 0 / 0.16),
      inset 0 0 0 1px rgb(0 0 0 / 0.08),
      inset 0 calc(var(--door-w) * 0.006) calc(var(--door-w) * 0.01) rgb(0 0 0 / 0.06);
  }

  .door__panel--top {
    top: 7%;
    height: 66%;
  }

  .door__panel--bottom {
    top: 79%;
    height: 14.5%;
  }

  /* Hinges on the outer edges. */
  .door__hinge {
    position: absolute;
    width: max(1.5px, calc(var(--door-w) * 0.012));
    height: 4.5%;
    background: linear-gradient(90deg, #5a5a5a, #a9a9a9 50%, #555);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.25);
  }

  .door__hinge--top {
    top: 12%;
  }

  .door__hinge--bottom {
    top: 84%;
  }

  .door__leaf--left .door__hinge {
    left: 0;
  }

  .door__leaf--right .door__hinge {
    right: 0;
  }

  /* Steel bar pulls on two posts, near the meeting stiles, with a shadow on the door. */
  .door__handle {
    position: absolute;
    top: 43%;
    width: max(2px, calc(var(--door-w) * 0.016));
    height: 28%;
    border-radius: 999px;
    background: linear-gradient(90deg, #333, #7d7d7d 30%, #d6d6d6 48%, #8a8a8a 64%, #2e2e2e);
    box-shadow:
      calc(var(--door-w) * 0.007) calc(var(--door-w) * 0.016) calc(var(--door-w) * 0.014) rgb(0 0 0 / 0.36),
      0 0 0 0.5px rgb(0 0 0 / 0.35);
  }

  .door__handle::before,
  .door__handle::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 160%;
    height: max(2px, calc(var(--door-w) * 0.012));
    translate: -50% 0;
    border-radius: 1px;
    background: linear-gradient(90deg, #444, #a5a5a5 50%, #3c3c3c);
  }

  .door__handle::before {
    top: 7%;
  }

  .door__handle::after {
    bottom: 7%;
  }

  .door__leaf--left .door__handle {
    right: 8%;
  }

  .door__leaf--right .door__handle {
    left: 8%;
  }

  /* Light over everything on the leaf (panels included): brighter at the top, darker low down. */
  .door__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.2),
      transparent 26%,
      transparent 52%,
      rgb(0 0 0 / 0.11)
    );
    pointer-events: none;
  }

  /* Leaf thickness: a strip on the free edge, turned 90° into the room. Edge-on (invisible) while
     the door is shut; it shows as the leaf swings open. */
  .door__edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(var(--door-w) * 0.035);
    background: linear-gradient(to bottom, #e9e9e9, #b9b9b9);
    transition: background-color 800ms var(--ease-out);
  }

  .door__leaf--left .door__edge {
    left: 100%;
    transform-origin: left center;
    transform: rotateY(90deg);
  }

  .door__leaf--right .door__edge {
    right: 100%;
    transform-origin: right center;
    transform: rotateY(-90deg);
  }

  /* As a leaf turns into the room it darkens and catches the brand's light. */
  .door__leaf::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 800ms var(--ease-in-out);
    pointer-events: none;
  }

  .door__leaf--left::after {
    background: linear-gradient(90deg, rgb(0 0 0 / 0.55), color-mix(in srgb, var(--brand) 55%, transparent));
  }

  .door__leaf--right::after {
    background: linear-gradient(270deg, rgb(0 0 0 / 0.55), color-mix(in srgb, var(--brand) 55%, transparent));
  }

  /* Glossy floor: the door reflected just below, bright and clear at the floor line, smeared
     downwards (the hall's #floor-smear blurs along y only) and fading. */
  .door__mirror {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: calc(var(--door-h) * 1.4);
    opacity: 0.85;
    filter: url(#floor-smear);
    /* Fades downwards, and feathers at the sides so it has no hard edges. */
    -webkit-mask-image:
      linear-gradient(to bottom, #000, rgb(0 0 0 / 0.7) 22%, rgb(0 0 0 / 0.3) 45%, transparent 70%),
      linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, #000, rgb(0 0 0 / 0.7) 22%, rgb(0 0 0 / 0.3) 45%, transparent 70%),
      linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-composite: intersect;
    pointer-events: none;
  }

  .door__mirror .door__frame {
    transform: scaleY(-1);
  }

  /* The floor reflects the room's light, not a mirrored copy of the brand's name. */
  .door__mirror .door__mark,
  .door__mirror .door__brand {
    visibility: hidden;
  }

  /* The brand's light falling out of the open door onto the floor. */
  .door__spill {
    position: absolute;
    top: 100%;
    left: 50%;
    width: calc(var(--door-w) * 2.2);
    height: calc(var(--door-h) * 1.2);
    translate: -50% 0;
    background: radial-gradient(
      ellipse 40% 75% at 50% 0%,
      color-mix(in srgb, var(--brand) 45%, transparent),
      transparent 70%
    );
    clip-path: polygon(30% 0, 70% 0, 100% 100%, 0 100%);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
    pointer-events: none;
  }

  /* ── Open: hover, keyboard focus, entering (.is-open), centred on narrow screens ── */

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__leaf {
    transition: transform 1100ms var(--ease-out);
  }

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__leaf--left {
    transform: rotateY(74deg);
  }

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__leaf--right {
    transform: rotateY(-74deg);
  }

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__leaf::after {
    opacity: 1;
  }

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__edge {
    background-color: var(--brand);
    background-blend-mode: multiply;
  }

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__inside {
    filter: brightness(1);
  }

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__frame {
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.65),
      0 calc(var(--door-w) * 0.02) calc(var(--door-w) * 0.07) rgb(0 0 0 / 0.7),
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 1px 0 0 rgb(255 255 255 / 0.5),
      inset -1px 0 0 rgb(0 0 0 / 0.15),
      0 0 calc(var(--door-w) * 0.6) color-mix(in srgb, var(--brand) 22%, transparent);
  }

  .door:is(:hover, :focus-visible, .is-open, .is-centered) .door__spill,
  .bay:has(.door:is(:hover, :focus-visible, .is-open, .is-centered)) .bay__glow::after {
    opacity: 1;
  }

  .door:focus-visible {
    outline: none;
  }

  .door:focus-visible .door__body .door__frame {
    outline: 1px solid var(--color-fg);
    outline-offset: calc(var(--door-w) * 0.07);
  }

  /* Walking in: the leaves swing fully open, and only the brand's light is left (the mark and
     name fade) as the hall zooms. */
  :global(.is-entering) .door.is-open .door__leaf--left {
    transform: rotateY(88deg);
  }

  :global(.is-entering) .door.is-open .door__leaf--right {
    transform: rotateY(-88deg);
  }

  :global(.is-entering) .door__mark,
  :global(.is-entering) .door__brand {
    opacity: 0;
  }

  /* The leaves' thickness only matters while they swing; hide it for the zoom, where a strongly
     scaled 3D strip can render out of place. */
  :global(.is-entering) .door__edge {
    visibility: hidden;
  }

  /* ── Lights on (page load): each light flickers on, then its light and door appear ── */

  .bay__fixture {
    animation: light-on 1100ms linear backwards;
    animation-delay: calc(250ms + var(--i) * 220ms);
  }

  .bay__glow,
  .bay__cone,
  .bay__pool,
  .bay__streak,
  .bay__glint,
  .door {
    animation: lit 1400ms var(--ease-out) backwards;
    animation-delay: calc(650ms + var(--i) * 220ms);
