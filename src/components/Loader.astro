---
/**
 * Ring loader (started from reference/Loading.jpeg; the bulb's base and gap were removed
 * at the user's request, leaving a full glowing circle).
 *
 * The ring is the loading bar: light enters at the bottom, travels clockwise all the way
 * round back to the bottom, then drains away in the same direction and loops. Once the page
 * has loaded and the minimum time has passed, it stops fully lit, blooms, and fades into
 * the page. Timing lives in the <script> below.
 *
 * Geometry is in viewBox units, measured from the reference (1 unit = 1px of that image).
 */
const CX = 60;
const CY = 60;
const R = 40; // radius of the ring
const STROKE = 10; // thickness of the ring

// Two half-circles, starting at the bottom and running clockwise (up the left side first).
const ring = `M ${CX} ${CY + R} A ${R} ${R} 0 1 1 ${CX} ${CY - R} A ${R} ${R} 0 1 1 ${CX} ${CY + R}`;
const ringLength = +(2 * Math.PI * R).toFixed(3);
---

<div class="loader" data-loader role="status">
  <span class="sr-only">Loading</span>
  <svg class="ring" data-ring viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs>
      <!-- Room light; falloff matched to the reference's brightness at 1.5–4 ring radii. -->
      <radialGradient id="ring-ambient">
        <stop offset="0" stop-color="#fff" stop-opacity="0.15"></stop>
        <stop offset="0.3" stop-color="#fff" stop-opacity="0.115"></stop>
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.08"></stop>
        <stop offset="0.7" stop-color="#fff" stop-opacity="0.045"></stop>
        <stop offset="0.85" stop-color="#fff" stop-opacity="0.015"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <filter id="ring-glow" x="-50%" y="-50%" width="200%" height="200%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="halo"></feGaussianBlur>
        <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="bloom"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="halo"></feMergeNode>
          <feMergeNode in="bloom"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
      <filter id="ring-flare" x="-75%" y="-75%" width="250%" height="250%" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="14"></feGaussianBlur>
      </filter>
    </defs>

    <circle class="ring__ambient" data-ambient cx={CX} cy={CY} r="150" fill="url(#ring-ambient)"></circle>
    <path class="ring__track" d={ring} stroke-width={STROKE}></path>
    <path class="ring__flare" data-flare d={ring} stroke-width={STROKE} filter="url(#ring-flare)"></path>
    <path
      class="ring__light"
      data-light
      data-length={ringLength}
      d={ring}
      stroke-width={STROKE}
      stroke-linecap="round"
      stroke-dasharray={`${ringLength} ${ringLength * 2}`}
      stroke-dashoffset={ringLength}
      filter="url(#ring-glow)"></path>
  </svg>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    place-items: center;
    overflow: hidden;
    background: var(--color-bg);
  }

  :global(.js-loading) .loader {
    display: grid;
  }

  /* Grain with a faint vertical streak (noise stretched along y), as in the reference. */
  .loader::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.06;
    pointer-events: none;
  }

  /* Same scale as the old bulb (its 150-unit height was clamp(150px, 26vmin, 230px)). */
  .ring {
    width: auto;
    height: clamp(120px, 20.8vmin, 184px);
    aspect-ratio: 1;
    overflow: visible;
  }

  .ring__ambient {
    opacity: 0.08; /* a barely-there haze at rest; the script brightens it as the ring fills */
    transform-box: fill-box;
    transform-origin: center;
  }

  .ring__track {
    fill: none;
    stroke: rgb(255 255 255 / 0.07);
  }

  .ring__light,
  .ring__flare {
    fill: none;
    stroke: #fff;
    opacity: 0;
  }
</style>

<script>
  // Timing, in ms. The loader always shows for at least MIN_DURATION_MS (a deliberate delay
  // so it is seen), then leaves the next time the ring is fully lit after the page has loaded.
  const MIN_DURATION_MS = 3000;
  const MAX_WAIT_MS = 8000; // stop waiting for slow assets after this
  const FILL_MS = 1500; // light travels once round the ring, bottom to bottom, clockwise
  const DRAIN_MS = 750; // light leaves the ring, in the same direction
  const LIT_MS = 450; // "lights on" bloom once loading is done
  const LEAVE_MS = 800; // loader fades out while the page fades in

  const EASE_IN_OUT = 'cubic-bezier(0.65, 0, 0.35, 1)';
  const EASE_OUT = 'cubic-bezier(0.22, 1, 0.36, 1)';

  const root = document.documentElement;
  const main = document.querySelector('main');
  const loader = document.querySelector<HTMLElement>('[data-loader]');

  if (loader && !root.classList.contains('js-loading')) {
    // BaseLayout's bootstrap skipped the loader (e.g. arriving from another page of the site).
    loader.remove();
  } else if (loader) {
    if (main) main.inert = true;
    play(loader)
      .catch((error) => console.error('[loader]', error))
      .finally(() => finish(loader));
  }

  async function play(loader: HTMLElement) {
    const ring = loader.querySelector<SVGSVGElement>('[data-ring]')!;
    const light = loader.querySelector<SVGPathElement>('[data-light]')!;
    const flare = loader.querySelector<SVGPathElement>('[data-flare]')!;
    const ambient = loader.querySelector<SVGCircleElement>('[data-ambient]')!;
    const length = Number(light.dataset.length);
    const dim = Number(getComputedStyle(ambient).opacity);
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const pageLoaded = new Promise<void>((resolve) => {
      if (document.readyState === 'complete') resolve();
      else addEventListener('load', () => resolve(), { once: true });
    });
    let loaded = false;
    pageLoaded.then(() => (loaded = true));
    const isReady = () => (loaded && performance.now() >= MIN_DURATION_MS) || performance.now() >= MAX_WAIT_MS;

    // Moves the light along the ring (via its dash offset); the room light follows it.
    const sweep = (from: number, to: number, duration: number, glowFrom: number, glowTo: number) => {
      const timing = { duration, easing: EASE_IN_OUT, fill: 'forwards' } as const;
      return Promise.all([
        light.animate({ strokeDashoffset: [`${from}px`, `${to}px`] }, timing).finished,
        ambient.animate({ opacity: [glowFrom, glowTo] }, timing).finished,
      ]);
    };

    if (reduceMotion) {
      // No sweeping: the ring simply lights up, then the page fades in.
      light.style.strokeDashoffset = '0';
      const timing = { duration: 600, fill: 'forwards' } as const;
      light.animate({ opacity: [0, 1] }, timing);
      ambient.animate({ opacity: [dim, 1] }, timing);
      await Promise.race([
        Promise.all([pageLoaded, sleep(MIN_DURATION_MS - performance.now())]),
        sleep(MAX_WAIT_MS - performance.now()),
      ]);
    } else {
      while (true) {
        // Fill: the light enters at the bottom and travels clockwise all the way round.
        light.animate({ opacity: [0, 1] }, { duration: FILL_MS * 0.15, fill: 'forwards' });
        await sweep(length, 0, FILL_MS, dim, 1);
        if (isReady()) break;
        // Drain: the tail follows round, so the light leaves at the bottom again.
        light.animate({ opacity: [1, 0] }, { duration: DRAIN_MS * 0.2, delay: DRAIN_MS * 0.8, fill: 'forwards' });
        await sweep(0, -length, DRAIN_MS, 1, dim);
      }

      // Lights on.
      const lit = { duration: LIT_MS, easing: EASE_OUT, fill: 'forwards' } as const;
      await Promise.all([
        flare.animate({ opacity: [0, 0.6] }, lit).finished,
        ambient.animate({ transform: ['scale(1)', 'scale(1.25)'] }, lit).finished,
      ]);
    }

    // Leave: the loader fades out while the page rises in underneath.
    const leave = { duration: LEAVE_MS, easing: EASE_IN_OUT, fill: 'forwards' } as const;
    if (!reduceMotion) ring.animate({ transform: ['scale(1)', 'scale(1.06)'] }, { ...leave, easing: EASE_OUT });
    const fade = loader.animate({ opacity: [1, 0] }, leave);
    setTimeout(() => root.classList.add('is-loaded'), LEAVE_MS * 0.3);
    await fade.finished;
  }

  function finish(loader: HTMLElement) {
    root.classList.add('is-loaded');
    root.classList.remove('js-loading');
    if (main) main.inert = false;
    loader.remove();
  }

  function sleep(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, Math.max(0, ms)));
  }
</script>
