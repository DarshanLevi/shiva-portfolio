---
/**
 * A brand's page: TEMPLATE with placeholder content until the real case studies arrive in
 * contents/. It opens full-screen in the brand's light, the same light the visitor just walked
 * into through its door on /branding, so the zoom hands over seamlessly; the case study follows.
 *
 * The opening screen is now the project gallery (src/components/Gallery.astro): a dark room with
 * the projects as artworks, swipe / arrows to move between them, and the whole room's colours
 * follow the active project. The brand's light still hands over from the door: it fades away to
 * reveal the room. The case study below follows the active project's colour and "next" link.
 */
import Gallery from '../../components/Gallery.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brands, type Brand } from '../../data/brands';

export function getStaticPaths() {
  return brands.map((brand, i) => ({
    params: { slug: brand.slug },
    props: { brand, next: brands[(i + 1) % brands.length], index: i },
  }));
}

interface Props {
  brand: Brand;
  next: Brand;
  index: number;
}

const { brand, next, index } = Astro.props;
// TODO(content): real facts, story and images from contents/.
const facts = ['Client', 'Year', 'Scope'];
const frames = ['01', '02', '03'];
---

<BaseLayout title={`${brand.name} — Branding — Shiva`} description={`${brand.name}: branding case study.`}>
  <SiteHeader back={{ href: '/branding', label: 'Branding' }} />
  <main class="brand" style={`--brand: ${brand.color}`}>
    <h1 class="sr-only" data-brand-title>{brand.name}</h1>
    <Gallery brands={brands} start={index} />

    <section class="brand__body" aria-label="Case study">
      <dl class="brand__facts">
        {
          facts.map((label) => (
            <div>
              <dt>{label}</dt>
              <dd>TBD</dd>
            </div>
          ))
        }
      </dl>
      <p class="brand__intro">
        Placeholder for the story of this brand: the brief, the idea, and how the identity came together.
      </p>
      <ul class="brand__gallery" aria-label="Images">
        {
          frames.map((n) => (
            <li class="frame">
              <span>Image {n}</span>
            </li>
          ))
        }
      </ul>
      <a class="brand__next" href={`/branding/${next.slug}`} data-brand-next>
        <span class="brand__next-label">Next brand</span>
        <span class="brand__next-name" data-brand-next-name>{next.name}</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  /* ── Case study (placeholder) ── */

  .brand__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* stops the content from widening the page on phones */
    gap: clamp(2.5rem, 6vw, 5rem);
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter) clamp(4rem, 10vw, 8rem);
  }

  .brand__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .brand__facts dt,
  .brand__next-label,
  .frame {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .brand__facts dd {
    margin: 0.5rem 0 0;
  }

  .brand__intro {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .brand__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frame {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 4 / 5;
    padding: 1rem;
    border: 1px solid var(--color-line);
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--brand) 16%, transparent), transparent 70%),
      rgb(255 255 255 / 0.015);
  }

  .frame:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.05;
    pointer-events: none;
  }

  .brand__next {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-fg);
    text-decoration: none;
  }

  .brand__next-name {
    font-size: clamp(1.25rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: translate 500ms var(--ease-out);
  }

  .brand__next:hover .brand__next-name,
  .brand__next:focus-visible .brand__next-name {
    translate: 0.4rem 0;
  }

  .brand__next:focus-visible {
    outline: 1px solid var(--color-fg);
    outline-offset: 0.5rem;
  }

  @media (max-width: 40rem) {
    .brand__gallery {
      grid-template-columns: 1fr;
    }

    .frame:first-child {
      grid-column: auto;
    }
  }
</style>

<script>
  // The gallery moves between projects without leaving the page: keep the address, the page title,
  // the case study's colour and its "next brand" link in step with the active project.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  gallery?.addEventListener('gallery:change', (event) => {
    const { project, next, url } = (event as CustomEvent).detail as {
      project: { name: string; color: string };
      next: { slug: string; name: string };
      url: string;
    };
    history.replaceState(null, '', url);
    document.title = `${project.name} — Branding — Shiva`;
    const main = document.querySelector<HTMLElement>('.brand');
    main?.style.setProperty('--brand', project.color);
    const heading = document.querySelector('[data-brand-title]');
    if (heading) heading.textContent = project.name;
    const link = document.querySelector<HTMLAnchorElement>('[data-brand-next]');
    if (link) link.href = `/branding/${next.slug}`;
    const nextName = document.querySelector('[data-brand-next-name]');
    if (nextName) nextName.textContent = next.name;
  });
</script>
